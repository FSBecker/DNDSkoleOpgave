ontal=1;rounded=0;fillColor=#e6f3ec;swimlaneFillColor=#ffffff;strokeColor=#4e8066;fontColor=#253649;fontSize=17;fontStyle=1;collapsible=0;align=center;" vertex="1" parent="1"><mxGeometry x="1570" y="850" width="580" height="192" as="geometry"/></mxCell><mxCell id="CombatAction-attributes" value="+ Name: string&#xa;+ ActionCost: int&#xa;+ Effects: List&lt;ActionEffect&gt;" style="text;html=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=16;fontColor=#253649;strokeColor=none;fillColor=none;overflow=hidden;" vertex="1" parent="CombatAction"><mxGeometry x="0" y="50" width="580" height="82" as="geometry"/></mxCell><mxCell id="CombatAction-methods" value="+ RollDamage(): int&#xa;+ RollDamage(dice): int" style="text;html=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=16;fontColor=#253649;strokeColor=none;fillColor=none;overflow=hidden;" vertex="1" parent="CombatAction"><mxGeometry x="0" y="132" width="580" height="60" as="geometry"/></mxCell><mxCell id="CombatAction-separator" style="line;strokeColor=#4e8066;" vertex="1" parent="CombatAction"><mxGeometry x="0" y="132" width="580" height="0" as="geometry"/></mxCell><mxCell id="note0" value="CoreCharacter er abstrakt og implementerer IDamageable. PlayerCharacter og EnemyCharacter arver samme grundfunktioner.&#xa;Hver karakter refererer til præcis én CharacterRace og én CharacterClass. Flere karakterer kan referere til samme objekt.&#xa;EquipmentSlots ejes af karakteren. Inventory og Actions er lister med 0..* elementer; de kan indeholde delte referencer.&#xa;Alle spillets 110 typer samt de to testtyper findes på fanerne. Der vises udvalgte medlemmer for at holde diagrammet læseligt." style="shape=note;html=0;size=15;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=16;fillColor=#f5f7fa;strokeColor=#c2ccd8;fontColor=#435366;" vertex="1" parent="1"><mxGeometry x="45" y="1400" width="2100" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pa